# YouTube API Keys (multiple for load balancing)
YOUTUBE_API_KEYS=your_api_key_1,your_api_key_2

# Email Configuration
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# Default Recipients (used if account doesn't specify)
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com

# ========== Feishu Bot Configuration ==========
# Get webhook URL from Feishu group settings
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx
# Time to send Feishu message (HH:MM format, 24-hour)
FEISHU_SEND_TIME=08:00

# ========== Multi-Account Configuration (JSON Format) ==========
# Important: Must be valid JSON format!
YOUTUBE_ACCOUNTS=[
  {
    "account_id": "account_1",
    "account_name": "Main Channel Account",
    "channels": ["UCxxxxxx", "UCyyyyyy", "UCzzzzzz"],
    "api_key": "your_api_key_1",
    "recipients": ["boss@company.com", "manager@company.com"],
    "feishu_webhook": ""
  },
  {
    "account_id": "account_2",
    "account_name": "Branch Channel Account",
    "channels": ["UCaaaaaa", "UCbbbbbb"],
    "api_key": "your_api_key_2",
    "recipients": ["team@company.com"],
    "feishu_webhook": ""
  },
  {
    "account_id": "account_3",
    "account_name": "Test Channel",
    "channels": ["UCcccccc"],
    "api_key": "your_api_key_1",
    "recipients": [],
    "feishu_webhook": ""
  }
]

# Schedule Time (HH:MM format, 24-hour)
SCHEDULE_TIME=09:00

# Timezone
TIMEZONE=UTC

# Report Settings
ENABLE_DETAILED_REPORT=true
REPORT_DAYS=30
